+@interface RNSInteractivePopBarFader : NSObject
+- (instancetype)initWithBar:(UINavigationBar *)bar
+                coordinator:(id<UIViewControllerTransitionCoordinator>)coordinator;
+- (void)start;
+- (void)finishCancelled:(BOOL)cancelled;
+@end
+
+@implementation RNSInteractivePopBarFader {
+  UINavigationBar *_bar;
+  id<UIViewControllerTransitionCoordinator> _coordinator;
+  CADisplayLink *_displayLink;
+  CGFloat _lowestAlpha;
+}
+
+- (instancetype)initWithBar:(UINavigationBar *)bar
+                coordinator:(id<UIViewControllerTransitionCoordinator>)coordinator
+{
+  if (self = [super init]) {
+    _bar = bar;
+    _coordinator = coordinator;
+    _lowestAlpha = 1;
+  }
+  return self;
+}
+
+- (void)start
+{
+  _displayLink = [CADisplayLink displayLinkWithTarget:self selector:@selector(step)];
+  [_displayLink addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+  [self step];
+}
+
+- (void)step
+{
+  // Hidden by a tenth of the swipe; never comes back while the pop is undecided.
+  CGFloat progress = _coordinator.percentComplete;
+  _lowestAlpha = MIN(_lowestAlpha, MAX(0, 1 - progress * 10));
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  _bar.alpha = _lowestAlpha;
+  [CATransaction commit];
+}
+
+- (void)finishCancelled:(BOOL)cancelled
+{
+  [_displayLink invalidate];
+  _displayLink = nil;
+  if (!cancelled) {
+    _bar.alpha = 1;
+    return;
+  }
+  UINavigationBar *bar = _bar;
+  [UIView animateWithDuration:0.2
+                        delay:0
+                      options:UIViewAnimationOptionBeginFromCurrentState
+                   animations:^{
+                     bar.alpha = 1;
+                   }
+                   completion:nil];
+}
+
+@end
+
