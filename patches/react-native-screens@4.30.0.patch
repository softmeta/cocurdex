+// On iOS 26, a cancelled interactive pop towards a screen without a navigation bar
+// leaves the outgoing bar's items offset for the last frame before UIKit snaps them
+// back. UIKit does not drive animations added alongside the interactive pop on the
+// bar's layer, so the bar follows the gesture's progress frame by frame instead: it
+// fades out early in the swipe, stays hidden through the cancel animation and its
+// final frame, and fades back in once the pop is cancelled.
++ (void)fadeNavigationBarDuringInteractivePop:(UINavigationController *)navctr
+                                  coordinator:(id<UIViewControllerTransitionCoordinator>)coordinator
+{
+  UINavigationBar *bar = navctr.navigationBar;
+  RNSInteractivePopBarFader *fader = [[RNSInteractivePopBarFader alloc] initWithBar:bar coordinator:coordinator];
+  [fader start];
+  [coordinator animateAlongsideTransition:nil
+                               completion:^(id<UIViewControllerTransitionCoordinatorContext> _Nonnull context) {
+                                 [fader finishCancelled:[context isCancelled]];
+                               }];
+}
