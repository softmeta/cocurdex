{
  "name": "@cocurdex/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cocurdex": "bin/cocurdex.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cocurdex/daemon": "workspace:*",
    "@cocurdex/product-skills": "workspace:*",
    "@cocurdex/rpc": "workspace:*",
    "@cocurdex/shared": "workspace:*",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15"
  },
  "exports": {
    "./internal/*": "./src/*.ts"
  }
}
