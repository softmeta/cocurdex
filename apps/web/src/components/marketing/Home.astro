---
import { getMarketingDict, localizedPath, type SiteLocale } from "../../i18n";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { site } from "../../lib/site";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const t = getMarketingDict(locale);
---

<MarketingLayout
  locale={locale}
  title={site.name}
  path={localizedPath(locale, "/")}
>
  <main>
    <section class="hero">
      <div class="hero__inner">
        <p class="eyebrow">{t.home.eyebrow}</p>
        <h1>{t.home.heading}</h1>
        <p class="lede">{t.home.lede}</p>
        <div class="actions">
          <a
            class="button button--primary"
            href={localizedPath(locale, "/download/")}>{t.home.downloadCta}</a
          >
          <a
            class="button button--secondary"
            href={localizedPath(locale, "/docs/")}>{t.home.docsCta}</a
          >
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="features-heading">
      <div class="section-inner">
        <h2 id="features-heading">{t.home.featuresHeading}</h2>
        <p>{t.home.featuresIntro}</p>
        <ul class="feature-grid">
          {
            t.home.features.map((feature) => (
              <li>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="agents-heading">
      <div class="section-inner">
        <h2 id="agents-heading">{t.home.agentsHeading}</h2>
        <p>{t.home.agentsIntro}</p>
        <div class="spec-table">
          <table>
            <thead>
              <tr>
                {t.home.agentColumns.map((column) => <th>{column}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                t.home.agentRows.map((agent) => (
                  <tr>
                    <td>{agent.name}</td>
                    <td>{agent.runtime}</td>
                    <td>{agent.plan}</td>
                    <td>{agent.steering}</td>
                    <td>{agent.permissions}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="section-link">
          <a href={localizedPath(locale, "/docs/agents/")}>{t.home.agentsMore}</a>
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="capabilities-heading">
      <div class="section-inner">
        <h2 id="capabilities-heading">{t.home.capabilitiesHeading}</h2>
        <p>{t.home.capabilitiesIntro}</p>
        <ul class="feature-grid feature-grid--three">
          {
            t.home.capabilities.map((capability) => (
              <li>
                <h3>
                  <a href={capability.href}>{capability.title}</a>
                </h3>
                <p>{capability.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="next-heading">
      <div class="section-inner">
        <h2 id="next-heading">{t.home.startHeading}</h2>
        <p>{t.home.startBody}</p>
        <div class="actions">
          <a
            class="button button--secondary"
            href={localizedPath(locale, "/docs/getting-started/")}
            >{t.home.gettingStarted}</a
          >
          <a
            class="button button--secondary"
            href={localizedPath(locale, "/docs/desktop/")}
            >{t.home.desktopOverview}</a
          >
        </div>
      </div>
    </section>
  </main>
</MarketingLayout>
