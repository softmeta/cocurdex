---
import MarketingLayout from "../layouts/MarketingLayout.astro";

const macArm64DownloadUrl =
  "https://github.com/softmeta/cocurdex/releases/latest/download/Cocurdex-mac-arm64.dmg";
---

<MarketingLayout
  title="Download"
  description="Download Cocurdex for macOS. Windows and Linux builds follow. Pre-release."
  path="/download/"
>
  <main class="prose-page">
    <p class="eyebrow">Pre-release</p>
    <h1>Download Cocurdex</h1>
    <p>
      Download the signed and notarized macOS build for Apple silicon. Cocurdex
      is still in pre-release, so APIs and workflows may change between builds.
    </p>
    <div class="actions" style="margin-top: 1.75rem">
      <a class="button button--primary" href={macArm64DownloadUrl}
        >Download for Apple silicon</a
      >
      <a
        class="button button--secondary"
        href="https://github.com/softmeta/cocurdex/releases/latest"
        >Release notes</a
      >
    </div>
    <ul>
      <li><strong>macOS Apple silicon</strong> — available</li>
      <li><strong>macOS Intel</strong> — coming later</li>
      <li><strong>Windows</strong> — next</li>
      <li><strong>Linux</strong> — after Windows</li>
    </ul>
    <div class="note">
      Open the DMG, drag Cocurdex to Applications, then launch it from your
      Applications folder. Every public macOS build is signed with Developer ID
      and notarized by Apple.
    </div>
    <div class="actions" style="margin-top: 1.75rem">
      <a class="button button--secondary" href="/docs/">Read the docs</a>
      <a class="button button--secondary" href="/">Back to home</a>
    </div>
  </main>
</MarketingLayout>
