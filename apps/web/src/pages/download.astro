---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { desktopDownloads, githubLatestReleaseUrl } from "../lib/site";
---

<MarketingLayout
  title="Download"
  description="Download Cocurdex for macOS, Windows, and Linux. Pre-release."
  path="/download/"
>
  <main class="prose-page">
    <p class="eyebrow">Pre-release</p>
    <h1>Download Cocurdex</h1>
    <p>
      Pre-release builds for macOS, Windows, and Linux. APIs and workflows may
      change between versions.
    </p>
    <ul class="download-builds">
      {
        desktopDownloads.map((build, index) => (
          <li>
            <a
              class:list={[
                "button",
                index === 0 ? "button--primary" : "button--secondary",
              ]}
              data-build={build.id}
              href={build.href}
            >
              {build.label}
            </a>
            <p>{build.note}</p>
          </li>
        ))
      }
    </ul>
    <div class="actions" style="margin-top: 1.75rem">
      <a class="button button--secondary" href={githubLatestReleaseUrl}
        >Release notes</a
      >
    </div>
    <div class="note">
      On macOS, open the DMG and drag Cocurdex to Applications. Every public
      macOS build is signed with Developer ID and notarized by Apple. Windows
      installers are unsigned.
    </div>
    <div class="actions" style="margin-top: 1.75rem">
      <a class="button button--secondary" href="/docs/">Read the docs</a>
      <a class="button button--secondary" href="/">Back to home</a>
    </div>
  </main>
</MarketingLayout>

<script>
  function detectBuildIdFromUserAgent() {
    const userAgent = navigator.userAgent;
    if (/Windows NT/i.test(userAgent)) {
      return "win-x64";
    }
    if (/Linux/i.test(userAgent) && !/Android/i.test(userAgent)) {
      return "linux-x64";
    }
    return "mac-arm64";
  }

  async function detectBuildId() {
    const userAgentData = (
      navigator as Navigator & {
        userAgentData?: {
          getHighEntropyValues?: (hints: string[]) => Promise<{
            architecture?: string;
            platform?: string;
          }>;
        };
      }
    ).userAgentData;
    if (typeof userAgentData?.getHighEntropyValues === "function") {
      try {
        const hints = await userAgentData.getHighEntropyValues([
          "architecture",
          "platform",
        ]);
        const platform = String(hints.platform ?? "").toLowerCase();
        const architecture = String(hints.architecture ?? "").toLowerCase();
        if (platform.includes("win")) {
          return "win-x64";
        }
        if (platform.includes("linux")) {
          return "linux-x64";
        }
        if (platform.includes("mac")) {
          if (architecture.includes("x86") || architecture === "x64") {
            return "mac-x64";
          }
          return "mac-arm64";
        }
      } catch {
        return detectBuildIdFromUserAgent();
      }
    }
    return detectBuildIdFromUserAgent();
  }

  const recommended = await detectBuildId();
  for (const link of document.querySelectorAll("[data-build]")) {
    const isRecommended = link.getAttribute("data-build") === recommended;
    link.classList.toggle("button--primary", isRecommended);
    link.classList.toggle("button--secondary", !isRecommended);
  }
</script>
