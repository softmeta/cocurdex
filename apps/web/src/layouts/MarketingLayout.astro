---
import {
  getMarketingDict,
  htmlLangs,
  localeLabels,
  localizedPath,
  locales,
  ogLocales,
  unlocalizedPath,
  type SiteLocale,
} from "../i18n";
import { site } from "../lib/site";
import "../styles/marketing.css";

interface Props {
  locale: SiteLocale;
  title: string;
  description?: string;
  /** Locale-prefixed path, e.g. "/" or "/zh-cn/download/". */
  path?: string;
  noindex?: boolean;
}

const { locale, title, path = "/" , noindex = false } = Astro.props;
const dict = getMarketingDict(locale);
const description = Astro.props.description ?? dict.meta.description;

const canonical = new URL(path, site.url).href;
const basePath = unlocalizedPath(path);
const alternates = locales.map((entry) => ({
  locale: entry,
  hreflang: htmlLangs[entry],
  href: new URL(localizedPath(entry, basePath), site.url).href,
}));
const pageTitle = title === site.name ? title : `${title} · ${site.name}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux",
  description: dict.meta.description,
  url: site.url,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/PreOrder",
  },
};
---

<!doctype html>
<html lang={htmlLangs[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternates.find((a) => a.locale === "en")?.href ?? canonical}
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:image" content={new URL("/cocurdex-icon.svg", site.url).href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0c0c0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={localizedPath(locale, "/")}>
          <img src="/cocurdex-icon.svg" alt="" width="24" height="24" />
          <span>{site.name}</span>
        </a>
        <nav class="nav" aria-label={dict.nav.primaryAria}>
          <a
            href={localizedPath(locale, "/docs/")}
            aria-current={basePath.startsWith("/docs") ? "page" : undefined}
            >{dict.nav.docs}</a
          >
          <a
            href={localizedPath(locale, "/download/")}
            class="nav-cta"
            aria-current={basePath === "/download/" || basePath === "/download"
              ? "page"
              : undefined}>{dict.nav.download}</a
          >
          {
            locales
              .filter((entry) => entry !== locale)
              .map((entry) => (
                <a
                  class="nav-locale"
                  href={localizedPath(entry, basePath)}
                  hreflang={htmlLangs[entry]}
                >
                  {localeLabels[entry]}
                </a>
              ))
          }
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>© {new Date().getFullYear()} {site.name}. {dict.footer.tagline}</p>
        <nav aria-label={dict.nav.footerAria}>
          <a href={localizedPath(locale, "/docs/")}>{dict.nav.docs}</a>
          <a href={localizedPath(locale, "/download/")}>{dict.nav.download}</a>
          <a href={localizedPath(locale, "/docs/getting-started/")}
            >{dict.footer.gettingStarted}</a
          >
        </nav>
      </div>
    </footer>
  </body>
</html>
