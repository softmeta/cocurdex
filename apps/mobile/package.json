{
  "name": "@cocurdex/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    "./internal/*": "./src/*.ts"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:theme-colors": "node scripts/generate-theme-colors.mjs",
    "check:theme-colors": "node scripts/generate-theme-colors.mjs --check",
    "i18n:extract": "i18next-cli extract --config ./i18next.config.ts",
    "i18n:lint": "i18next-cli lint --config ./i18next.config.ts",
    "i18n:types": "i18next-cli types --config ./i18next.config.ts",
    "generate:mermaid-runtime": "node scripts/build-mermaid-runtime.mjs",
    "check:mermaid-runtime": "node scripts/build-mermaid-runtime.mjs --check",
    "generate:note-editor-runtime": "node scripts/build-note-editor-runtime.mjs",
    "check:note-editor-runtime": "node scripts/build-note-editor-runtime.mjs --check"
  },
  "dependencies": {
    "@cocurdex/client-runtime": "workspace:*",
    "@cocurdex/shared": "workspace:*",
    "@expo/ui": "~58.0.0",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "beautiful-mermaid": "^1.1.3",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.0",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.0",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.0",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.0",
    "i18next": "^26.5.3",
    "react": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-shiki-engine": "^0.4.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "remend": "^1.4.0",
    "shiki": "^4.5.0",
    "swr": "^2.5.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cocurdex/note-doc": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "@types/culori": "4.0.1",
    "@types/react": "~19.3.0",
    "culori": "4.0.2",
    "esbuild": "^0.28.2",
    "i18next-cli": "^1.77.0",
    "mermaid": "11.16.1",
    "typescript": "6.0.3"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": false
  }
}
