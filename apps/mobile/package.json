{
  "name": "@cocurdex/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    "./internal/*": "./src/*.ts"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ensure:native-assets": "node scripts/ensure-native-assets.mjs",
    "generate:theme-colors": "node scripts/generate-theme-colors.mjs",
    "check:theme-colors": "node scripts/generate-theme-colors.mjs --check",
    "i18n:extract": "i18next-cli extract --config ./i18next.config.ts",
    "i18n:lint": "i18next-cli lint --config ./i18next.config.ts",
    "i18n:types": "i18next-cli types --config ./i18next.config.ts",
    "generate:mermaid-runtime": "node scripts/build-mermaid-runtime.mjs",
    "check:mermaid-runtime": "node scripts/build-mermaid-runtime.mjs --check",
    "generate:note-editor-runtime": "node scripts/build-note-editor-runtime.mjs",
    "check:note-editor-runtime": "node scripts/build-note-editor-runtime.mjs --check"
  },
  "dependencies": {
    "@cocurdex/client-runtime": "workspace:*",
    "@cocurdex/secure-channel": "workspace:*",
    "@cocurdex/shared": "workspace:*",
    "@expo/ui": "~58.0.22",
    "@formatjs/intl-pluralrules": "^6.4.0",
    "beautiful-mermaid": "^1.1.3",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.0",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.0",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.7.2",
    "react": "19.3.1",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-shiki-engine": "^0.5.0",
    "react-native-svg": "15.16.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "remend": "^1.4.0",
    "shiki": "^4.6.0",
    "swr": "^2.5.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cocurdex/note-doc": "workspace:*",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/y-tiptap": "^3.2.0",
    "@types/culori": "4.0.1",
    "@types/react": "~19.3.0",
    "culori": "4.0.2",
    "esbuild": "^0.28.2",
    "i18next-cli": "^1.86.0",
    "mermaid": "12.3.0",
    "typescript": "7.0.2"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": true
  }
}
