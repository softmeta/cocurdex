{
  "name": "@cocurdex/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "exports": {
    "./internal/*": "./src/*.ts"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:theme-colors": "node scripts/generate-theme-colors.mjs",
    "check:theme-colors": "node scripts/generate-theme-colors.mjs --check",
    "i18n:extract": "i18next-cli extract --config ./i18next.config.ts",
    "i18n:lint": "i18next-cli lint --config ./i18next.config.ts",
    "i18n:types": "i18next-cli types --config ./i18next.config.ts"
  },
  "dependencies": {
    "@cocurdex/client-runtime": "workspace:*",
    "@cocurdex/rpc": "workspace:*",
    "@cocurdex/shared": "workspace:*",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.0",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.0",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.0",
    "i18next": "^26.5.3",
    "react": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/culori": "4.0.1",
    "@types/react": "~19.3.0",
    "culori": "4.0.2",
    "i18next-cli": "^1.77.0",
    "typescript": "6.0.3"
  },
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": false
  }
}
