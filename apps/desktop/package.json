{
  "name": "@cocurdex/desktop",
  "productName": "Cocurdex",
  "version": "0.1.0",
  "description": "Cocurdex desktop app",
  "author": "softmeta LLC",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "pnpm run prepare:electron && pnpm run prepare:cli && electron-vite dev",
    "dev:inspect": "pnpm run prepare:electron && pnpm run prepare:cli && COCURDEX_REMOTE_DEBUGGING_PORT=9222 electron-vite dev",
    "perf:listen": "node ./scripts/listen-renderer-perf.mjs",
    "build": "pnpm run prepare:fd && pnpm run prepare:cli && electron-vite build",
    "dist:dir": "pnpm run prepare:fd && pnpm run prepare:cli && electron-vite build && electron-builder --dir",
    "dist:mac": "pnpm run prepare:fd -- --target darwin-universal && pnpm run prepare:cli && electron-vite build && electron-builder --mac",
    "dist:mac:arm64": "pnpm run prepare:fd -- --target darwin-arm64 && pnpm run prepare:cli && electron-vite build && electron-builder --mac --arm64 --publish never",
    "i18n:extract": "i18next-cli extract --config ./i18next.config.ts",
    "i18n:lint": "node ./scripts/lint-i18n.mjs",
    "lint:cycles": "node ./scripts/check-cycles.mjs",
    "i18n:sync": "i18next-cli sync --config ./i18next.config.ts",
    "i18n:types": "i18next-cli types --config ./i18next.config.ts",
    "postinstall": "node ./scripts/fix-node-pty-perms.mjs",
    "prepare:cli": "node ./scripts/build-cli.mjs",
    "prepare:electron": "install-electron --no",
    "prepare:fd": "node ./scripts/ensure-fd.mjs",
    "verify:package": "node ./scripts/verify-packaged-runtime.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo"
  },
  "dependencies": {
    "@cocurdex/daemon": "workspace:*",
    "@cocurdex/rpc": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "electron-log": "^5.4.3",
    "font-list": "^2.1.0",
    "node-pty": "^1.1.0",
    "pi-mcp-adapter": "2.11.0",
    "simple-git": "^3.36.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-linux-arm": "1.18.0",
    "@vscode/ripgrep-linux-arm64": "1.18.0",
    "@vscode/ripgrep-linux-ia32": "1.18.0",
    "@vscode/ripgrep-linux-ppc64": "1.18.0",
    "@vscode/ripgrep-linux-riscv64": "1.18.0",
    "@vscode/ripgrep-linux-s390x": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-arm64": "1.18.0",
    "@vscode/ripgrep-win32-ia32": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "^1.1.19",
    "@pierre/trees": "1.0.0-beta.3",
    "@shikijs/monaco": "^3.23.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.26",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-drag-handle-react": "^3.30.5",
    "@tiptap/extension-list": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "github-slugger": "^2.0.0",
    "i18next": "^26.0.8",
    "i18next-cli": "^1.56.9",
    "jotai": "^2.20.3",
    "jsdom": "^26.1.0",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.6",
    "react-resizable-panels": "^4.11.1",
    "shadcn": "^4.8.0",
    "shiki": "^3.23.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "dev.cocurdex.desktop",
    "productName": "Cocurdex",
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "files": [
      "out/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.{ts,tsx,cts,mts}",
      "node_modules/pi-mcp-adapter/**/*",
      "!node_modules/**/{demo,demos,doc,docs,example,examples,test,tests,__tests__}/**/*",
      "!node_modules/**/*.{md,markdown}",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "!node_modules/recheck-jar/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@vscode/ripgrep/**/*",
      "node_modules/@vscode/ripgrep-*/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/fd",
        "to": "vendor/fd",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/cli",
        "to": "cli",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../packages/product-skills/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "artifactName": "Cocurdex-mac-${arch}.${ext}",
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        "dir",
        "dmg"
      ],
      "files": [
        "out/**",
        "!node_modules/koffi/**"
      ]
    }
  }
}
