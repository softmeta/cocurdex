registry=https://registry.npmjs.org/

# Keep cookie majors un-hoisted. Astro 7 wants cookie@2; express/MCP keep
# cookie@0.7. Hoisting either version to a single root slot breaks the other
# (and parent ~/node_modules/cookie can shadow the wrong one during SSR).
public-hoist-pattern[]=!cookie
hoist-pattern[]=!cookie
