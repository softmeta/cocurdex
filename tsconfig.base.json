{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@cocurdex/shared/node": ["./packages/shared/src/node.ts"],
      "@cocurdex/shared": ["./packages/shared/src/index.ts"],
      "@cocurdex/rpc": ["./packages/rpc/src/index.ts"],
      "@cocurdex/rpc/client": ["./packages/rpc/src/client.ts"],
      "@cocurdex/rpc/method-scopes": ["./packages/rpc/src/method-scopes.ts"],
      "@cocurdex/client-runtime": ["./packages/client-runtime/src/index.ts"],
      "@cocurdex/secure-channel": ["./packages/secure-channel/src/index.ts"],
      "@cocurdex/daemon": ["./packages/daemon/src/index.ts"],
      "@cocurdex/daemon/client": ["./packages/daemon/src/client.ts"],
      "@cocurdex/daemon/paths": ["./packages/daemon/src/paths.ts"],
      "@cocurdex/agent-core": ["./packages/agent-core/src/index.ts"],
      "@cocurdex/agent-adapters": ["./packages/agent-adapters/src/index.ts"],
      "@cocurdex/agent-adapters/desktop-provider": [
        "./packages/agent-adapters/src/desktop-provider.ts"
      ],
      "@cocurdex/db": ["./packages/db/src/index.ts"],
      "@cocurdex/note-doc/bytes": ["./packages/note-doc/src/bytes.ts"],
      "@cocurdex/note-doc": ["./packages/note-doc/src/index.ts"],
      "@cocurdex/deck": ["./packages/deck/src/index.ts"],
      "@cocurdex/deck/markdown": ["./packages/deck/src/markdown.ts"],
      "@cocurdex/deck/pptx": ["./packages/deck/src/pptx.ts"],
      "@cocurdex/product-skills": ["./packages/product-skills/src/index.ts"],
      "@cocurdex/api": ["./apps/api/src/index.ts"],
      "@cocurdex/agent-adapters/internal/*": [
        "./packages/agent-adapters/src/*"
      ],
      "@cocurdex/agent-core/internal/*": ["./packages/agent-core/src/*"],
      "@cocurdex/mobile/internal/*": ["./apps/mobile/src/*"],
      "@cocurdex/client-runtime/internal/*": [
        "./packages/client-runtime/src/*"
      ],
      "@cocurdex/daemon/internal/*": ["./packages/daemon/src/*"],
      "@cocurdex/db/internal/*": ["./packages/db/src/*"],
      "@cocurdex/note-doc/internal/*": ["./packages/note-doc/src/*"],
      "@cocurdex/deck/internal/*": ["./packages/deck/src/*"],
      "@cocurdex/product-skills/internal/*": [
        "./packages/product-skills/src/*"
      ],
      "@cocurdex/rpc/internal/*": ["./packages/rpc/src/*"],
      "@cocurdex/secure-channel/internal/*": [
        "./packages/secure-channel/src/*"
      ],
      "@cocurdex/shared/internal/*": ["./packages/shared/src/*"],
      "@cocurdex/cli/internal/*": ["./apps/cli/src/*"],
      "@cocurdex/api/internal/*": ["./apps/api/src/*"]
    }
  }
}
