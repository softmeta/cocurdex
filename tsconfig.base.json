{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@cocurdex/shared": ["./packages/shared/src/index.ts"],
      "@cocurdex/rpc": ["./packages/rpc/src/index.ts"],
      "@cocurdex/daemon": ["./packages/daemon/src/index.ts"],
      "@cocurdex/daemon/client": ["./packages/daemon/src/client.ts"],
      "@cocurdex/daemon/paths": ["./packages/daemon/src/paths.ts"],
      "@cocurdex/agent-core": ["./packages/agent-core/src/index.ts"],
      "@cocurdex/agent-adapters": ["./packages/agent-adapters/src/index.ts"],
      "@cocurdex/agent-adapters/desktop-provider": [
        "./packages/agent-adapters/src/desktop-provider.ts"
      ],
      "@cocurdex/db": ["./packages/db/src/index.ts"],
      "@cocurdex/llm-chat": ["./packages/llm-chat/src/index.ts"],
      "@cocurdex/product-skills": ["./packages/product-skills/src/index.ts"],
      "@cocurdex/api": ["./apps/api/src/index.ts"]
    }
  }
}
