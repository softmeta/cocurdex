{
  "name": "@cocurdex/daemon",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./paths": "./src/paths.ts",
    "./internal/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "daemon": "node --import tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cocurdex/agent-adapters": "workspace:*",
    "@cocurdex/agent-core": "workspace:*",
    "@cocurdex/db": "workspace:*",
    "@cocurdex/deck": "workspace:*",
    "@cocurdex/note-doc": "workspace:*",
    "@cocurdex/product-skills": "workspace:*",
    "@cocurdex/rpc": "workspace:*",
    "@cocurdex/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "^2.1.1",
    "@vscode/ripgrep": "^1.18.0",
    "diff": "^9.0.0",
    "effect": "4.0.5",
    "font-list": "^2.1.0",
    "node-pty": "^1.1.0",
    "simple-git": "^4.0.2",
    "tar": "^7.5.22",
    "undici": "^8.12.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "yjs": "^13.6.33"
  }
}
