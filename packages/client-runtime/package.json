{
  "name": "@cocurdex/client-runtime",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./remote-files": "./src/remote-files.ts",
    "./secure-transport": "./src/secure-transport.ts",
    "./internal/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cocurdex/rpc": "workspace:*",
    "@cocurdex/secure-channel": "workspace:*",
    "@cocurdex/shared": "workspace:*"
  },
  "devDependencies": {}
}
