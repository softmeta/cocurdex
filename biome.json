{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["**", "!.agents", "!**/.claude"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["lazy", "Suspense"],
                    "message": "Use lazyComponent from @/lib: React delays the first reveal after a Suspense fallback by 300 ms."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/**", "!apps/desktop/src/components/ui/**"],
      "plugins": ["./biome-plugins/no-effect-outside-hooks.grit"]
    }
  ]
}
