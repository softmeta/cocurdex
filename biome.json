{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!**/.claude",
      "!apps/mobile/src/markdown/mermaid-runtime.generated.ts",
      "!apps/mobile/src/notes/editor/note-editor-runtime.generated.ts"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "error"
          },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["lazy", "Suspense"],
                    "message": "Use lazyComponent from @/lib: React delays the first reveal after a Suspense fallback by 300 ms."
                  }
                },
                "patterns": [
                  {
                    "group": ["@cocurdex/*/internal/*"],
                    "message": "Internal subpaths exist only for tests in tests/unit; import the package public entry."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**", "packages/**", "!apps/desktop/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "expo-router": {
                    "importNames": ["router"],
                    "message": "Use useRouter(): the imperative router is unbound whenever its bridge remounts, and a tap then crashes the app."
                  },
                  "react-native": {
                    "importNames": ["useColorScheme"],
                    "message": "Use useThemeName() from @/theme: Appearance.setColorScheme notifies listeners only after a native round trip, so screens read the new scheme a frame before the native header and tab bar."
                  }
                },
                "patterns": [
                  {
                    "group": ["@cocurdex/*/internal/*"],
                    "message": "Internal subpaths exist only for tests in tests/unit; import the package public entry."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/daemon/src/**",
        "packages/agent-adapters/src/**",
        "!packages/daemon/src/daemon-logging.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/**", "!apps/desktop/src/components/ui/**"],
      "plugins": ["./biome-plugins/no-effect-outside-hooks.grit"]
    },
    {
      "includes": [
        "apps/desktop/src/**/*.tsx",
        "!apps/desktop/src/components/ui/**"
      ],
      "plugins": ["./biome-plugins/no-hoisted-class-names.grit"]
    },
    {
      "includes": [
        "tests/**",
        "!tests/scenarios/lib/**",
        "!tests/e2e/helpers/**",
        "!tests/e2e/fixture-db/**",
        "!tests/fixtures/temp-dirs.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "Use createTempDirs() from @cocurdex/test-fixtures/temp-dirs: its cleanup retries the removal, so Windows can release open handles before the directory is deleted."
                  },
                  "node:fs/promises": {
                    "importNames": ["mkdtemp"],
                    "message": "Use createTempDirs() from @cocurdex/test-fixtures/temp-dirs: its cleanup retries the removal, so Windows can release open handles before the directory is deleted."
                  },
                  "fs": {
                    "importNames": ["mkdtemp", "mkdtempSync"],
                    "message": "Use createTempDirs() from @cocurdex/test-fixtures/temp-dirs: its cleanup retries the removal, so Windows can release open handles before the directory is deleted."
                  },
                  "fs/promises": {
                    "importNames": ["mkdtemp"],
                    "message": "Use createTempDirs() from @cocurdex/test-fixtures/temp-dirs: its cleanup retries the removal, so Windows can release open handles before the directory is deleted."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
