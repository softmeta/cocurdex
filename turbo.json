{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "loose",
  "globalPassThroughEnv": [
    "COCURDEX_SCENARIO_RECORD_DIR",
    "COCURDEX_TEST_ARTIFACTS_DIR"
  ],
  "globalDependencies": [
    ".npmrc",
    "pnpm-workspace.yaml",
    "patches/**",
    "tsconfig.base.json",
    "tsconfig.json"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@cocurdex/desktop#build": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "@cocurdex/desktop#check:startup-bundle": {
      "dependsOn": ["@cocurdex/desktop#build"],
      "cache": false
    },
    "@cocurdex/e2e#test": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!desktop/**",
        "!vitest.desktop.config.ts",
        "!headless/**",
        "!vitest.headless.config.ts"
      ]
    },
    "@cocurdex/e2e#test:desktop": {
      "dependsOn": ["^transit", "@cocurdex/desktop#build"],
      "cache": false,
      "inputs": ["desktop/**", "vitest.desktop.config.ts", "helpers/**"]
    },
    "@cocurdex/desktop#build:headless": {
      "dependsOn": ["@cocurdex/desktop#build"],
      "cache": false
    },
    "@cocurdex/e2e#test:headless": {
      "dependsOn": ["^transit", "@cocurdex/desktop#build:headless"],
      "cache": false,
      "inputs": [
        "headless/**",
        "vitest.headless.config.ts",
        "helpers/**",
        "$TURBO_ROOT$/apps/desktop/scripts/build-headless.mjs",
        "$TURBO_ROOT$/apps/desktop/scripts/build-cli.mjs",
        "$TURBO_ROOT$/apps/desktop/scripts/pe-subsystem.mjs"
      ]
    },
    "@cocurdex/unit-scripts#test": {
      "dependsOn": ["transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/release.mjs",
        "$TURBO_ROOT$/scripts/release/**"
      ]
    },
    "@cocurdex/scenarios#test:ui": {
      "dependsOn": ["^transit", "@cocurdex/desktop#build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.agents/skills/debug-desktop/scripts/**"
      ]
    }
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true
  }
}
