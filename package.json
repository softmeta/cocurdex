{
  "name": "@cocurdex/workspace",
  "version": "0.1.0",
  "description": "A desktop-first multi-agent development workspace",
  "author": "softmeta LLC",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softmeta/cocurdex.git"
  },
  "homepage": "https://cocurdex.com",
  "bugs": {
    "url": "https://github.com/softmeta/cocurdex/issues"
  },
  "scripts": {
    "acp:probe": "node ./scripts/acp-probe.mjs",
    "prepare": "lefthook install",
    "lint:design-tokens": "node ./scripts/lint-design-tokens.mjs",
    "lint:theme-parity": "node ./scripts/lint-theme-parity.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.17",
    "typescript": "6.0.3"
  }
}
